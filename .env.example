# Serveur
PORT=3000
NODE_ENV=development

# Base de donnees
MONGODB_URI=mongodb://localhost:27017/ai-sales-agent

# Moteur de l'agent commercial : "openai" (Codex) ou "claude"
AGENT_PROVIDER=openai

# OpenAI / Codex (utilise si AGENT_PROVIDER=openai)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# Renseignez ici le modele exact fourni par votre acces Codex (verifiez sur
# platform.openai.com/docs/models) - gpt-4.1 est laisse en repli fonctionnel.
CODEX_MODEL=gpt-4.1

# Anthropic / Claude (utilise si AGENT_PROVIDER=claude)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
AGENT_MODEL=claude-sonnet-5

# Exa (recherche web) - utilisee par l'outil search_web quand le catalogue
# et la FAQ internes ne suffisent pas, seulement si autorise dans les
# parametres de l'agent (peutRechercherSurInternet)
EXA_API_KEY=

# Auth tableau de bord (admin)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# WhatsApp (session Baileys - connecte au numero existant via QR code)
WHATSAPP_SESSION_DIR=./whatsapp-session

# Relances automatiques
FOLLOWUP_CHECK_INTERVAL_CRON=*/15 * * * *
FOLLOWUP_DELAY_MINUTES=60

# Notifications humaines (webhook interne, ex: Slack/email a brancher)
HUMAN_ALERT_WEBHOOK_URL=
