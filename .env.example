# Serveur
PORT=3000
NODE_ENV=development

# Base de donnees
MONGODB_URI=mongodb://localhost:27017/ai-sales-agent

# Anthropic (agent commercial IA)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
AGENT_MODEL=claude-sonnet-5

# Auth tableau de bord (admin)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# WhatsApp (session Baileys - connecte au numero existant via QR code)
WHATSAPP_SESSION_DIR=./whatsapp-session

# Relances automatiques
FOLLOWUP_CHECK_INTERVAL_CRON=*/15 * * * *
FOLLOWUP_DELAY_MINUTES=60

# Notifications humaines (webhook interne, ex: Slack/email a brancher)
HUMAN_ALERT_WEBHOOK_URL=
